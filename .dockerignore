# Build context is the repo root — keep the image small and secrets out.
.git
.github
.venv
**/.venv
**/__pycache__
**/*.pyc
.pytest_cache
**/.pytest_cache
.ruff_cache
**/.ruff_cache

# Never bake secrets or local config into the image (mount them at /config).
secrets.yaml
secrets*.yaml
config.yaml
config.local.yaml
*.synced.yaml

# Internal/large material not needed at runtime.
raw-sources
llm-docs
docs
docker
**/tests
**/*.md
