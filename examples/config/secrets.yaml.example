# Copy to secrets.yaml — NEVER commit real values. All values here are placeholders.
#
# Per-device credentials are required for LAN-direct tools (except IC2-only devices).
# Tiers:
#   read_only   -> api.read-only  (status/info)
#   config_read -> api            (config GET; MCP read-only tier)
#   admin       -> api            (writes/cmd)
# Userpass accounts also work; OAuth API clients give cleaner least-privilege.
#
# APs use SNMP: provide snmp.community per AP; HTTP auth is optional and unused by
# the SNMP MCP tools. IC2-only devices need no credentials here.

auth_profiles:
  router-api-clients:
    read_only:
      type: client_credentials
      client_id: REPLACE_RO_CLIENT_ID
      client_secret: REPLACE_RO_CLIENT_SECRET
      scope: api.read-only
    config_read:
      type: client_credentials
      client_id: REPLACE_CONFIG_READ_CLIENT_ID
      client_secret: REPLACE_CONFIG_READ_CLIENT_SECRET
      scope: api
    admin:
      type: client_credentials
      client_id: REPLACE_ADMIN_CLIENT_ID
      client_secret: REPLACE_ADMIN_CLIENT_SECRET
      scope: api

  router-readonly-userpass:
    read_only:
      type: userpass
      username: rouser
      password: REPLACE_PASSWORD

devices:
  gateway:
    auth_profile: router-api-clients

  branch-router:
    auth_profile: router-readonly-userpass

  hub:
    auth:
      read_only:
        type: userpass
        username: rouser
        password: REPLACE_PASSWORD
      config_read:
        type: userpass
        username: admin
        password: REPLACE_ADMIN_PASSWORD

  switch-1:
    auth:
      read_only:
        type: userpass
        username: switch-ro
        password: REPLACE_PASSWORD

  ap-1:
    snmp:
      community: REPLACE_SNMP_COMMUNITY

# MCP API key secrets — one GUID per key_ref in config.yaml mcp_keys. NEVER commit
# real values. Generate with: peplink-device-mcp keys generate --id NAME --tier TIER
mcp_keys:
  local_readonly: "REPLACE-WITH-A-GENERATED-GUID"
  ops_admin: "REPLACE-WITH-A-GENERATED-GUID"

# InControl 2 cloud OAuth2 credentials (only needed when incontrol2.enabled: true).
# IC2 API clients inherit the creating user's permissions. Provide a single client
# for both tiers, or split into a read-only and an admin client.
#
# Option A — one client for both reads and writes:
incontrol2:
  auth:
    grant_type: client_credentials
    client_id: REPLACE_IC2_CLIENT_ID
    client_secret: REPLACE_IC2_CLIENT_SECRET
#
# Option B — least-privilege split (omit `auth` above):
#   read_only:
#     client_id: REPLACE_IC2_RO_CLIENT_ID
#     client_secret: REPLACE_IC2_RO_CLIENT_SECRET
#   admin:
#     client_id: REPLACE_IC2_RW_CLIENT_ID
#     client_secret: REPLACE_IC2_RW_CLIENT_SECRET
